BITRIX_WEBHOOK_URL=https://seudominio.bitrix24.com.br/rest/ID/TOKEN
OPENAI_API_KEY=sk-...
PORT=3000
# CORS_ORIGIN=https://seu-frontend.com  (deixe vazio para permitir qualquer origem)

# API_KEY: se definida, exige header "x-api-key" para acessar /tasks
